CRBOT_API_KEY=cbak-prod-xxx
CRBOT_BASE=https://api.cr.bot/v1
# фильтры очереди
MIN_RUB=500
MAX_RUB=15000
MIN_REWARD=0.05
BRAND_BAN=
MCC_BAN=
# WS_TOKEN_MODE=1 — подключаться по ws_token (нужен IP whitelist), иначе api_key в URL
WS_TOKEN_MODE=0
# WS_CONNS=3 — сколько параллельных WS-коннектов слушают очередь (1..5, лимит ключа).
# Несколько коннектов = несколько мест в рассылке add: чьё событие придёт раньше, тот и стреляет take.
WS_CONNS=3
# счёт для complete (semi-кнопка C / auto). Пусто = первый с can_complete=true
ACCOUNT_ID=
# АВТОМАТ: пауза take -> complete, секунд (минимум 5; ранний complete = NotPaid!)
AUTO_DELAY_SEC=20
# Автобанк (ТОЛЬКО режим Авто): 1 = после take платить в Chrome (Альфа) и
# завершать только по успеху, иначе отмена (защита от NotPaid). Тест/Ловля не трогают.
AUTOPAY_ENABLED=0
ALFA_URL=https://web.alfabank.ru/dashboard/
AUTOPAY_TIMEOUT_SEC=120
# AUTOBANK_DRY=1 — сухой прогон: ищет кнопки/заполняет, но «Оплатить» НЕ жмёт (для теста на QR/ссылке)
AUTOBANK_DRY=0
# P2C_PLAIN=1 — без красивого дашборда, plain-логи (для скриптов/отладки)
# P2C_PLAIN=0
